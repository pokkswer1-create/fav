FAV_API_KEY=fav-local-dev-key
NEXT_PUBLIC_FAV_API_KEY=fav-local-dev-key
# Optional read-only key (GET /api/library)
FAV_READONLY_API_KEY=
FAV_HEAVY_CONCURRENCY=2
# Up to ~4h matches / multi-GB phone MOVs (streamed to disk, not kept in RAM)
FAV_MAX_UPLOAD_BYTES=12884901888
FAV_MAX_VIDEO_DURATION=14400
# Auto silence-detect / jersey OCR only (scout stamps still work on full length)
FAV_AUTO_ANALYZE_MAX_DURATION=1200
# Deep seeks into long sources need a longer ffmpeg budget
FAV_FFMPEG_TIMEOUT_MS=600000
# Longer sample for realism checks (seconds, 20–180)
FAV_SAMPLE_DURATION_SEC=20

# --- External integrations ---
# Roboflow jersey OCR (optional). When set, /api/video/track-player prefers Roboflow.
ROBOFLOW_API_KEY=
# e.g. basketball-jersey-numbers-ocr-bimwx/1 or your fine-tuned model
ROBOFLOW_JERSEY_MODEL=basketball-jersey-numbers-ocr-bimwx/1
# FIVB VIS is public (no key). Used by GET /api/fivb
# pydatavolley: pip install -r requirements-integrations.txt
