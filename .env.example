# Optional free market/disclosure APIs
# Korea Investment & Securities Open API (시세·일봉 백업)
KIS_APP_KEY=
KIS_APP_SECRET=
# 1 = 모의투자 서버(openapivts)
KIS_USE_MOCK=0

# OpenDART (공시 보강) — https://opendart.fss.or.kr
DART_API_KEY=

# 공공데이터포털 KRX 주식시세 (일봉 백업)
# https://www.data.go.kr — GetStockSecuritiesInfoService
KRX_SERVICE_KEY=
# alias
# DATA_GO_KR_SERVICE_KEY=

# aikstockdata 는 키 없이 자동 사용 (T+1 종가·공시 보조, 비상업·출처 표기)
